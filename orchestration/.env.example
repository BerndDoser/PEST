# Copy to orchestration/.env and fill in. Never commit .env (it is gitignored).

# Generate with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Generate with: openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# Login for the Airflow UI at http://localhost:8080
AIRFLOW_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Host directories mounted at /opt/airflow/data (inputs, SKIRT downloads) and
# /opt/airflow/output (one directory per DAG run). Relative paths are relative
# to orchestration/.
PEST_HOST_DATA_DIR=../data
PEST_HOST_OUTPUT_DIR=../output

# Number of PEST pipelines that may run at the same time.
PEST_POOL_SLOTS=1

# Secrets, only passed to the scheduler (which runs the tasks).
ILLUSTRIS_API_KEY=
HF_TOKEN=
